// KQL for auxiliary environmental monitoring layer.
// This layer is intentionally limited: the core scenario is planning, not operational dispatch.

.create-merge table EnvironmentalMonitoring (
  event_timestamp_utc: datetime,
  local_timezone: string,
  settlement_interval: string,
  source_system: string,
  quality_flag: string,
  ingestion_timestamp: datetime,
  data_version: string,
  monitoring_event_id: string,
  monitoring_point_id: string,
  location_id: string,
  sample_time_local: datetime,
  medium: string,
  parameter_name: string,
  value: real,
  unit: string,
  threshold_low: real,
  threshold_high: real,
  threshold: real,
  threshold_basis: string,
  exceedance_flag: int
)

// Latest exceedances by location.
EnvironmentalMonitoring
| where exceedance_flag == 1
| summarize exceedances=count(), last_event=max(event_timestamp_utc), max_ratio=max(value / threshold) by location_id, medium
| order by exceedances desc

// Activator source query: location and medium with repeated exceedances.
EnvironmentalMonitoring
| where event_timestamp_utc > ago(90d) and exceedance_flag == 1
| summarize exceedances_90d=count(), max_ratio=max(value / threshold) by location_id, medium
| where exceedances_90d >= 3 or max_ratio >= 1.25
