.create table OzeTelemetryRaw (event_timestamp_utc:datetime, local_timezone:string, settlement_interval:string, source_system:string, quality_flag:string, ingestion_timestamp:datetime, data_version:string, asset_id:string, telemetry_type:string, active_power_mw:real, available_power_mw:real, status_code:string, alarm_code:string)
.create table MarketPriceRaw (event_timestamp_utc:datetime, local_timezone:string, settlement_interval:string, source_system:string, quality_flag:string, ingestion_timestamp:datetime, data_version:string, trading_date:string, delivery_date:string, market_time_unit:string, market:string, price_pln_per_mwh:real, volume_mwh:real, balancing_area:string, pob_id:string, settlement_status:string)
.create table StorageStateRaw (event_timestamp_utc:datetime, local_timezone:string, settlement_interval:string, source_system:string, quality_flag:string, ingestion_timestamp:datetime, data_version:string, storage_id:string, storage_type:string, mode:string, stored_energy_mwh:real, state_of_charge_pct:real, round_trip_efficiency:real, net_power_mw:real, net_energy_mwh:real, upper_reservoir_level:real, lower_reservoir_level:real, generating_power_mw:real, pumping_power_mw:real, charging_power_mw:real, discharging_power_mw:real)
