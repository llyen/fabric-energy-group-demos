.create-merge table SourceTelemetry (event_timestamp_utc:datetime, local_timezone:string, settlement_interval:string, source_system:string, quality_flag:string, ingestion_timestamp:datetime, data_version:string, local_timestamp:datetime, heat_source_id:string, heat_production_mwh:real, electricity_generation_mwh:real, fuel_energy_mwh:real, emissions_tco2:real, operating_mode:string, supply_temp_c:real, return_temp_c:real, balance_residual_mwh:real)
.create-merge table StorageTelemetry (event_timestamp_utc:datetime, local_timezone:string, settlement_interval:string, source_system:string, quality_flag:string, ingestion_timestamp:datetime, data_version:string, local_timestamp:datetime, storage_id:string, charge_mwh:real, discharge_mwh:real, soc_mwh:real, standing_loss_mwh:real, roundtrip_efficiency_pct:real)
.create-merge table NetworkTelemetry (event_timestamp_utc:datetime, local_timezone:string, settlement_interval:string, source_system:string, quality_flag:string, ingestion_timestamp:datetime, data_version:string, local_timestamp:datetime, network_segment_id:string, supply_temp_c:real, return_temp_c:real, ambient_temp_c:real, heat_loss_mwh:real, flow_m3_h:real, pressure_bar:real)
.create-merge table WeatherHourly (event_timestamp_utc:datetime, local_timezone:string, settlement_interval:string, source_system:string, quality_flag:string, ingestion_timestamp:datetime, data_version:string, local_timestamp:datetime, city:string, temperature_c:real, inertia_temperature_c:real, wind_kmh:real, solar_irradiance_w_m2:real, is_frost_wave:bool)
.create-merge table ElectricityPrices (event_timestamp_utc:datetime, local_timezone:string, settlement_interval:string, source_system:string, quality_flag:string, ingestion_timestamp:datetime, data_version:string, local_timestamp:datetime, market:string, price_pln_per_mwh:real, volume_mwh:real, balancing_area:string, pob_id:string, settlement_status:string)

.create-merge table WeatherForecastHourly (event_timestamp_utc:datetime, local_timezone:string, settlement_interval:string, source_system:string, quality_flag:string, ingestion_timestamp:datetime, data_version:string, forecast_issue_local_timestamp:datetime, target_local_timestamp:datetime, forecast_horizon_h:int, city:string, forecast_temperature_c:real, forecast_inertia_temperature_c:real, forecast_wind_kmh:real, forecast_solar_irradiance_w_m2:real, is_frost_wave_forecast:bool)
